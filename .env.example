# All optional. VITE_* values are baked in at build time (pass as Docker build args).
# API base URL; defaults to the relative path /api (same domain as the app).
# VITE_BASE_URL=https://example.com/api
# Enables PostHog analytics when set.
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://eu.i.posthog.com
